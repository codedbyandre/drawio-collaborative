# Copy to .env and replace every value. Then:
#   docker compose up -d --build
#   ./scripts/check.sh

# Hostname only. No https:// and no path. A port is allowed for a local try.
# For a server, DNS A/AAAA for this name points at the machine running Docker.
#   server:  drawio.example.com
#   laptop:  localhost:8080
DRAWIO_PUBLIC_HOST=drawio.example.com

# Origin of the editor iframe. The browser opens the WebSocket from inside
# that iframe, so this is the editor, not your Nextcloud or app URL.
# Extra editor hostnames, if you really have them, are comma-separated.
DRAWIO_ORIGIN=https://drawio.example.com

# https for a server with a certificate, http for the laptop try.
# This picks wss:// or ws:// for the room socket.
DRAWIO_SCHEME=https

# Who may embed the editor. Exact origins, scheme and port included, separated
# by spaces. http://localhost:3000 and http://127.0.0.1:3000 are different
# origins, so the local example lists both.
# Add your Nextcloud origin here, for example https://cloud.example.com
DRAWIO_FRAME_ANCESTORS=http://localhost:3000 http://127.0.0.1:3000

# Same secret in this file and in the app that mints room tokens.
# Generate one with: openssl rand -hex 32
# An empty value makes every room reject the connection.
DRAWIO_RT_SECRET=replace-me

# Optional. Default 32. The next client is closed with 1013.
DRAWIO_RT_MAX_CLIENTS=32

# Used by Caddy for Let's Encrypt notices.
ACME_EMAIL=you@example.com

# Optional. Editor UI language.
DRAWIO_LANG=en
